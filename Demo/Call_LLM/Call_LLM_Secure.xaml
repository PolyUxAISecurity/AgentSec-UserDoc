            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[If(slackResponseContent Is Nothing, 0, CInt(slackResponseContent.StatusCode))]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Calculate Slack response length" sap2010:WorkflowViewState.IdRef="Assign_SlackResponseLength">
